% Russian add-on for kactlpkg: Cyrillic fonts, babel, Russian labels and
% Cyrillic inside lstlisting (pdflatex listings cannot handle multibyte UTF-8
% on its own, so every letter is mapped through `literate`).
\ProvidesPackage{kactl-ru}

\renewcommand{\kactldescriptionname}{Описание}
\renewcommand{\kactlusagename}{Использование}
\renewcommand{\kactlinputname}{Вход}
\renewcommand{\kactlmemoryname}{Память}
\renewcommand{\kactltimename}{Сложность}
\renewcommand{\kactllinesname}{строк}

% Courier (code font) has no Cyrillic. Code stays in T1 (Courier); Cyrillic letters
% in code are printed by glyph number in T2A CM-Super typewriter. Any other T2A
% \ttfamily text (e.g. \texttt in the table of contents) falls back to cmtt too.
\DeclareFontFamily{T2A}{pcr}{}
\DeclareFontShape{T2A}{pcr}{m}{n}{<->ssub * cmtt/m/n}{}
\DeclareFontShape{T2A}{pcr}{m}{it}{<->ssub * cmtt/m/it}{}
\DeclareFontShape{T2A}{pcr}{m}{sl}{<->ssub * cmtt/m/sl}{}
\DeclareFontShape{T2A}{pcr}{b}{n}{<->ssub * cmtt/m/n}{}
\DeclareFontShape{T2A}{pcr}{bx}{n}{<->ssub * cmtt/m/n}{}
\newcommand{\cyrtt}{\fontencoding{T2A}\fontfamily{cmtt}\selectfont}
\lstset{basicstyle=\footnotesize\fontencoding{T1}\ttfamily}

\lstset{extendedchars=true}
\lstset{literate=
